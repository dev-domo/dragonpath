# Upstage Agent connection (owned/prepared by another team member).
# Point these at the real agent once it is deployed; until then the
# /api/agent endpoints return a clear "not configured" error instead
# of failing silently.
AGENT_BASE_URL=
AGENT_API_KEY=

# Comma-separated origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:5173

# Toggle verbose request logging for local debugging.
DEBUG=true

# Upstage Studio document-check Agent — powers the real "Upload document"
# flow on the dashboard (distinct from AGENT_BASE_URL above, which is for
# a separate chat agent). Get a key at https://console.upstage.ai/api-keys
UPSTAGE_API_KEY=
